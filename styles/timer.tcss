TimerScreen {
    background: $background;
    
}
TimerScreen #timer-container {
    align: center middle;
}

TimerScreen #countdown {
    width: auto;
    text-style: bold;
    color: $primary;
    margin-bottom:3;
    margin-left: 37;
}

TimerScreen #progress {
    width: 60;
    margin-left: 24;
    margin-bottom: 3;
    padding: 0;

}

TimerScreen #controls {
    width: auto;
    height: auto;
    margin-left: 5;
}
# TimerScreen does everything inside of the controlss so bascially the buttons itself the group
TimerScreen #controls Button { 
    margin: 0 1;
    content-align:center middle;
    color: $primary
}
